import BoardModel

/-! GENERATED by prover/prooc.py. The model of Board, driven by the script on standard input. -/

partial def run (me : Board) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0", a0_0] =>
    match Score.new (BitVec.ofNat 32 a0_0.toNat!) with
    | none =>
      IO.println "mark pre"
      run me stdin
    | some o0 =>
      match Board.mark me o0 with
      | some (me, _) =>
        IO.println s!"mark - inv={if Board.Inv me then 1 else 0}"
        run me stdin
      | none => IO.println "mark MEMORY ERROR"
  | ["1", a0] =>
    match Board.mark_number me (BitVec.ofNat 32 a0.toNat!) with
    | some (me, _) =>
      IO.println s!"mark_number - inv={if Board.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "mark_number MEMORY ERROR"
  | ["2", a0_0] =>
    match Score.new (BitVec.ofNat 32 a0_0.toNat!) with
    | none =>
      IO.println "times pre"
      run me stdin
    | some o0 =>
      match Board.times me o0 with
      | some (me, r) =>
        IO.println s!"times {r.toNat} inv={if Board.Inv me then 1 else 0}"
        run me stdin
      | none => IO.println "times MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

def main : IO Unit := do
  match Board.new with
  | some me =>
    IO.println s!"new inv={if Board.Inv me then 1 else 0}"
    run me (← IO.getStdin)
  | none => IO.println "new MEMORY ERROR"
