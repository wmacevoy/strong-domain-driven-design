import RationModel

/-! GENERATED by prover/prooc.py. The model of Ration, driven by the script on standard input. -/

partial def run (me : Ration) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0", a0] =>
    match Ration.take me (BitVec.ofNat 32 a0.toNat!) with
    | some (me, r) =>
      if r matches Prooc.Outcome.ended then
        IO.println "take ended"
        return
      let said : String := match r with | Prooc.Outcome.gave r => toString r.toNat | _ => "thrown"
      IO.println s!"take {said} inv={if Ration.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "take MEMORY ERROR"
  | ["1"] =>
    match Ration.refill me with
    | some (me, r) =>
      let said : String := match r with | Prooc.Outcome.gave _ => "-" | _ => "thrown"
      IO.println s!"refill {said} inv={if Ration.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "refill MEMORY ERROR"
  | ["2"] =>
    match Ration.remaining me with
    | some (me, r) =>
      IO.println s!"remaining {r.toNat} inv={if Ration.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "remaining MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

def main : IO Unit := do
  match Ration.new with
  | some me =>
    IO.println s!"new inv={if Ration.Inv me then 1 else 0}"
    run me (← IO.getStdin)
  | none => IO.println "new MEMORY ERROR"
