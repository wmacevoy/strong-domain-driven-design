import StampModel

/-! GENERATED by prover/prooc.py. The model of Stamp, driven by the script on standard input. -/

partial def run (me : Stamp) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0", a0, a1] =>
    match Stamp.keep me (Prooc.Bytes.ofHex a0) (BitVec.ofNat 64 a1.toNat!) with
    | some (me, r) =>
      IO.println s!"keep {r.toNat} inv={if Stamp.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "keep MEMORY ERROR"
  | ["1", a0] =>
    match Stamp.keep_tail me (Prooc.Bytes.ofHex a0) with
    | some (me, _) =>
      IO.println s!"keep_tail - inv={if Stamp.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "keep_tail MEMORY ERROR"
  | ["2"] =>
    match Stamp.fold me with
    | some (me, _) =>
      IO.println s!"fold - inv={if Stamp.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "fold MEMORY ERROR"
  | ["3"] =>
    match Stamp.first me with
    | some (me, r) =>
      IO.println s!"first {r.toNat} inv={if Stamp.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "first MEMORY ERROR"
  | ["4"] =>
    match Stamp.count me with
    | some (me, r) =>
      IO.println s!"count {r.toNat} inv={if Stamp.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "count MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

def main : IO Unit := do
  match Stamp.new with
  | some me =>
    IO.println s!"new inv={if Stamp.Inv me then 1 else 0}"
    run me (← IO.getStdin)
  | none => IO.println "new MEMORY ERROR"
