import ClimbModel

/-! GENERATED by prover/prooc.py. The model of Climb, driven by the script on standard input. -/

partial def run (me : Climb) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0", a0] =>
    match Climb.add 4294967296 me (BitVec.ofNat 32 a0.toNat!) with
    | some (me, _) =>
      IO.println s!"add - inv={if Climb.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "add MEMORY ERROR"
  | ["1", a0] =>
    match Climb.above 4294967296 me (BitVec.ofNat 32 a0.toNat!) with
    | some (me, r) =>
      IO.println s!"above {r.toNat} inv={if Climb.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "above MEMORY ERROR"
  | ["2"] =>
    match Climb.get me with
    | some (me, r) =>
      IO.println s!"get {r.toNat} inv={if Climb.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "get MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

def main : IO Unit := do
  match Climb.new with
  | some me =>
    IO.println s!"new inv={if Climb.Inv me then 1 else 0}"
    run me (← IO.getStdin)
  | none => IO.println "new MEMORY ERROR"
