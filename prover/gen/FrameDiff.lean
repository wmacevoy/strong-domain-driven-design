import FrameModel

/-! GENERATED by prover/prooc.py. The model of Frame, driven by the script on standard input. -/

partial def run (me : Frame) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0", a0] =>
    match Frame.carried me (BitVec.ofNat 64 a0.toNat!) with
    | some (me, r) =>
      IO.println s!"carried {r.toNat} inv={if Frame.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "carried MEMORY ERROR"
  | ["1"] =>
    match Frame.last_body me with
    | some (me, r) =>
      IO.println s!"last_body {r.toNat} inv={if Frame.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "last_body MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

def main : IO Unit := do
  match Frame.new with
  | some me =>
    IO.println s!"new inv={if Frame.Inv me then 1 else 0}"
    run me (← IO.getStdin)
  | none => IO.println "new MEMORY ERROR"
