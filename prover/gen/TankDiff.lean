import TankModel

/-! GENERATED by prover/prooc.py. The model of Tank, driven by the script on standard input. -/

partial def run (me : Tank) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0", a0_0] =>
    match bounded_of.new 0#32 100#32 (BitVec.ofNat 32 a0_0.toNat!) with
    | none =>
      IO.println "fill pre"
      run me stdin
    | some o0 =>
      match Tank.fill me o0 with
      | some (me, _) =>
        IO.println s!"fill - inv={if Tank.Inv me then 1 else 0}"
        run me stdin
      | none => IO.println "fill MEMORY ERROR"
  | ["1", a0] =>
    match Tank.fill_number me (BitVec.ofNat 32 a0.toNat!) with
    | some (me, _) =>
      IO.println s!"fill_number - inv={if Tank.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "fill_number MEMORY ERROR"
  | ["2", a0_0] =>
    match bounded_checked_of.new 0#32 100#32 (BitVec.ofNat 32 a0_0.toNat!) with
    | none =>
      IO.println "fill_checked pre"
      run me stdin
    | some o0 =>
      match Tank.fill_checked me o0 with
      | some (me, _) =>
        IO.println s!"fill_checked - inv={if Tank.Inv me then 1 else 0}"
        run me stdin
      | none => IO.println "fill_checked MEMORY ERROR"
  | ["3"] =>
    match Tank.«at» me with
    | some (me, r) =>
      IO.println s!"at {r.toNat} inv={if Tank.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "at MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

def main : IO Unit := do
  match Tank.new with
  | some me =>
    IO.println s!"new inv={if Tank.Inv me then 1 else 0}"
    run me (← IO.getStdin)
  | none => IO.println "new MEMORY ERROR"
