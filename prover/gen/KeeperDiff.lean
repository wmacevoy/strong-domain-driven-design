import KeeperModel

/-! GENERATED by prover/prooc.py. The model of Keeper, driven by the script on standard input. -/

partial def run (me : Keeper) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0", a0] =>
    match Keeper.keep me (Prooc.Bytes.ofHex a0) with
    | some (me, r) =>
      let said : String := match r with | Prooc.Outcome.gave _ => "-" | _ => "thrown"
      IO.println s!"keep {said} inv={if Keeper.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "keep MEMORY ERROR"
  | ["1"] =>
    match Keeper.kept_count me with
    | some (me, r) =>
      IO.println s!"kept_count {r.toNat} inv={if Keeper.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "kept_count MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

def main : IO Unit := do
  match Keeper.new with
  | some me =>
    IO.println s!"new inv={if Keeper.Inv me then 1 else 0}"
    run me (← IO.getStdin)
  | none => IO.println "new MEMORY ERROR"
