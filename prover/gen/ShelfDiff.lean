import ShelfModel

/-! GENERATED by prover/prooc.py. The model of Shelf, driven by the script on standard input. -/

partial def run (me : Shelf) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0", a0] =>
    if ¬ (Shelf.add_pre me (BitVec.ofNat 32 a0.toNat!)) then
      IO.println "add pre"
      run me stdin
    else
      match Shelf.add me (BitVec.ofNat 32 a0.toNat!) with
      | some (me, _) =>
        IO.println s!"add - inv={if Shelf.Inv me then 1 else 0}"
        run me stdin
      | none => IO.println "add MEMORY ERROR"
  | ["1", a0] =>
    if ¬ (Shelf.at_pre me (BitVec.ofNat 32 a0.toNat!)) then
      IO.println "at pre"
      run me stdin
    else
      match Shelf.«at» me (BitVec.ofNat 32 a0.toNat!) with
      | some (me, r) =>
        IO.println s!"at {r.toNat} inv={if Shelf.Inv me then 1 else 0}"
        run me stdin
      | none => IO.println "at MEMORY ERROR"
  | ["2"] =>
    match Shelf.first me with
    | some (me, r) =>
      IO.println s!"first {r.toNat} inv={if Shelf.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "first MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

def main : IO Unit := do
  match Shelf.new with
  | some me =>
    IO.println s!"new inv={if Shelf.Inv me then 1 else 0}"
    run me (← IO.getStdin)
  | none => IO.println "new MEMORY ERROR"
