import WaterModel

/-! GENERATED by prover/prooc.py. The model of Water, driven by the script on standard input. -/

partial def run (me : Water) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0"] =>
    match Water.level me with
    | some (me, r) =>
      IO.println s!"level {r.toNat} inv={if Water.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "level MEMORY ERROR"
  | ["1", a0] =>
    if ¬ (Water.take_pre me (BitVec.ofNat 32 a0.toNat!)) then
      IO.println "take pre"
      run me stdin
    else
      match Water.take me (BitVec.ofNat 32 a0.toNat!) with
      | some (me, _) =>
        IO.println s!"take - inv={if Water.Inv me then 1 else 0}"
        run me stdin
      | none => IO.println "take MEMORY ERROR"
  | ["2"] =>
    match Water.fill me with
    | some (me, _) =>
      IO.println s!"fill - inv={if Water.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "fill MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

def main : IO Unit := do
  match Water.new with
  | some me =>
    IO.println s!"new inv={if Water.Inv me then 1 else 0}"
    run me (← IO.getStdin)
  | none => IO.println "new MEMORY ERROR"
