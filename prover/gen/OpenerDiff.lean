import OpenerModel

/-! GENERATED by prover/prooc.py. The model of Opener, driven by the script on standard input. -/

partial def run (me : Opener) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0", a0] =>
    match Opener.«open» me (Prooc.Bytes.ofHex a0) with
    | some (me, r) =>
      let said : String := match r with | Prooc.Outcome.gave _ => "-" | _ => "thrown"
      IO.println s!"open {said} inv={if Opener.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "open MEMORY ERROR"
  | ["1", a0] =>
    match Opener.again me (BitVec.ofNat 64 a0.toNat!) with
    | some (me, r) =>
      let said : String := match r with | Prooc.Outcome.gave _ => "-" | _ => "thrown"
      IO.println s!"again {said} inv={if Opener.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "again MEMORY ERROR"
  | ["2"] =>
    match Opener.count me with
    | some (me, r) =>
      IO.println s!"count {r.toNat} inv={if Opener.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "count MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

def main : IO Unit := do
  match Opener.new with
  | some me =>
    IO.println s!"new inv={if Opener.Inv me then 1 else 0}"
    run me (← IO.getStdin)
  | none => IO.println "new MEMORY ERROR"
