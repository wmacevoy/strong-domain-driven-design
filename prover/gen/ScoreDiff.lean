import ScoreModel

/-! GENERATED by prover/prooc.py. The model of Score, driven by the script on standard input. -/

partial def run (me : Score) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0"] =>
    match Score.number me with
    | some (me, r) =>
      IO.println s!"number {r.toNat} inv={if Score.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "number MEMORY ERROR"
  | ["1", c0] =>
    match Score.new (BitVec.ofNat 32 c0.toNat!) with
    | some me =>
      IO.println s!"new inv={if Score.Inv me then 1 else 0}"
      run me stdin
    | none =>
      IO.println "new pre"
      run me stdin
  | _ => IO.println "a line the script should not have"

partial def start (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["1", c0] =>
    match Score.new (BitVec.ofNat 32 c0.toNat!) with
    | some me =>
      IO.println s!"new inv={if Score.Inv me then 1 else 0}"
      run me stdin
    | none =>
      IO.println "new pre"
      start stdin
  | _ =>
    IO.println "no object"
    start stdin

def main : IO Unit := do
  start (← IO.getStdin)
