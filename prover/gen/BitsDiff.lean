import BitsModel

/-! GENERATED by prover/prooc.py. The model of Bits, driven by the script on standard input. -/

partial def run (me : Bits) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0", a0] =>
    match Bits.put me (BitVec.ofNat 64 a0.toNat!) with
    | some (me, _) =>
      IO.println s!"put - inv={if Bits.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "put MEMORY ERROR"
  | ["1", a0] =>
    match Bits.has me (BitVec.ofNat 64 a0.toNat!) with
    | some (me, r) =>
      IO.println s!"has {r.toNat} inv={if Bits.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "has MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

def main : IO Unit := do
  match Bits.new with
  | some me =>
    IO.println s!"new inv={if Bits.Inv me then 1 else 0}"
    run me (← IO.getStdin)
  | none => IO.println "new MEMORY ERROR"
