import JarModel

/-! GENERATED by prover/prooc.py. The model of Jar, driven by the script on standard input. -/

partial def run (me : Jar) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0", a0] =>
    match Jar.add me (BitVec.ofNat 32 a0.toNat!) with
    | some (me, _) =>
      IO.println s!"add - inv={if Jar.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "add MEMORY ERROR"
  | ["1"] =>
    match Jar.count me with
    | some (me, r) =>
      IO.println s!"count {r.toNat} inv={if Jar.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "count MEMORY ERROR"
  | ["2", a0] =>
    match Jar.roomFor me (BitVec.ofNat 32 a0.toNat!) with
    | some (me, r) =>
      IO.println s!"roomFor {r.toNat} inv={if Jar.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "roomFor MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

def main : IO Unit := do
  match Jar.new with
  | some me =>
    IO.println s!"new inv={if Jar.Inv me then 1 else 0}"
    run me (← IO.getStdin)
  | none => IO.println "new MEMORY ERROR"
