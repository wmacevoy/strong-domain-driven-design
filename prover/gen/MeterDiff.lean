import MeterModel

/-! GENERATED by prover/prooc.py. The model of Meter, driven by the script on standard input. -/

partial def run (me : Meter) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0", a0] =>
    match Meter.add me (BitVec.ofNat 32 a0.toNat!) with
    | some (me, r) =>
      IO.println s!"add {r.toNat} inv={if Meter.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "add MEMORY ERROR"
  | ["1"] =>
    match Meter.value me with
    | some (me, r) =>
      IO.println s!"value {r.toNat} inv={if Meter.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "value MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

def main : IO Unit := do
  match Meter.new with
  | some me =>
    IO.println s!"new inv={if Meter.Inv me then 1 else 0}"
    run me (← IO.getStdin)
  | none => IO.println "new MEMORY ERROR"
