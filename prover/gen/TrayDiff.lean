import TrayModel

/-! GENERATED by prover/prooc.py. The model of Tray, driven by the script on standard input. -/

partial def run (me : Tray) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0"] =>
    match Tray.held me with
    | some (me, r) =>
      IO.println s!"held {r.toNat} inv={if Tray.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "held MEMORY ERROR"
  | ["1"] =>
    match Tray.room me with
    | some (me, r) =>
      IO.println s!"room {r.toNat} inv={if Tray.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "room MEMORY ERROR"
  | ["2", a0] =>
    if ¬ (Tray.add_pre me (BitVec.ofNat 32 a0.toNat!)) then
      IO.println "add pre"
      run me stdin
    else
      match Tray.add me (BitVec.ofNat 32 a0.toNat!) with
      | some (me, _) =>
        IO.println s!"add - inv={if Tray.Inv me then 1 else 0}"
        run me stdin
      | none => IO.println "add MEMORY ERROR"
  | ["3"] =>
    match Tray.empty me with
    | some (me, _) =>
      IO.println s!"empty - inv={if Tray.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "empty MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

def main : IO Unit := do
  match Tray.new with
  | some me =>
    IO.println s!"new inv={if Tray.Inv me then 1 else 0}"
    run me (← IO.getStdin)
  | none => IO.println "new MEMORY ERROR"
