import TallyModel

/-! GENERATED by prover/prooc.py. The model of Tally, driven by the script on standard input. -/

partial def run (me : Tally) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0", a0] =>
    match Tally.see me (BitVec.ofNat 8 a0.toNat!) with
    | some (me, _) =>
      IO.println s!"see - inv={if Tally.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "see MEMORY ERROR"
  | ["1", a0] =>
    match Tally.«of» me (BitVec.ofNat 32 a0.toNat!) with
    | some (me, r) =>
      IO.println s!"of {r.toNat} inv={if Tally.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "of MEMORY ERROR"
  | ["2"] =>
    match Tally.getTotal me with
    | some (me, r) =>
      IO.println s!"getTotal {r.toNat} inv={if Tally.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "getTotal MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

def main : IO Unit := do
  match Tally.new with
  | some me =>
    IO.println s!"new inv={if Tally.Inv me then 1 else 0}"
    run me (← IO.getStdin)
  | none => IO.println "new MEMORY ERROR"
