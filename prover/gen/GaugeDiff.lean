import GaugeModel

/-! GENERATED by prover/prooc.py. The model of Gauge, driven by the script on standard input. -/

partial def run (me : Gauge) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0"] =>
    match Gauge.get me with
    | some (me, r) =>
      IO.println s!"get {r.toNat} inv={if Gauge.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "get MEMORY ERROR"
  | ["1"] =>
    match Gauge.getLimit me with
    | some (me, r) =>
      IO.println s!"getLimit {r.toNat} inv={if Gauge.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "getLimit MEMORY ERROR"
  | ["2", a0] =>
    match Gauge.set me (BitVec.ofNat 32 a0.toNat!) with
    | some (me, _) =>
      IO.println s!"set - inv={if Gauge.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "set MEMORY ERROR"
  | ["3", a0] =>
    match Gauge.setLimit me (BitVec.ofNat 32 a0.toNat!) with
    | some (me, _) =>
      IO.println s!"setLimit - inv={if Gauge.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "setLimit MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

def main : IO Unit := do
  match Gauge.new with
  | some me =>
    IO.println s!"new inv={if Gauge.Inv me then 1 else 0}"
    run me (← IO.getStdin)
  | none => IO.println "new MEMORY ERROR"
