import PercentModel

/-! GENERATED by prover/prooc.py. The model of Percent, driven by the script on standard input. -/

partial def run (me : Percent) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0"] =>
    match Percent.number me with
    | some (me, r) =>
      IO.println s!"number {r.toNat} inv={if Percent.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "number MEMORY ERROR"
  | ["1", c0] =>
    match Percent.new (BitVec.ofNat 32 c0.toNat!) with
    | some me =>
      IO.println s!"new inv={if Percent.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "new MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

def main : IO Unit := do
  match Percent.new 0#32 with
  | some me =>
    IO.println s!"new inv={if Percent.Inv me then 1 else 0}"
    run me (← IO.getStdin)
  | none => IO.println "new MEMORY ERROR"
