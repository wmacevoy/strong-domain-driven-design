import ChecksumModel

/-! GENERATED by prover/prooc.py. The model of Checksum, driven by the script on standard input. -/

partial def run (me : Checksum) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0", a0] =>
    match Checksum.add 4294967296 me (Prooc.Bytes.ofHex a0) with
    | some (me, _) =>
      IO.println s!"add - inv={if Checksum.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "add MEMORY ERROR"
  | ["1"] =>
    match Checksum.get me with
    | some (me, r) =>
      IO.println s!"get {r.toNat} inv={if Checksum.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "get MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

def main : IO Unit := do
  match Checksum.new with
  | some me =>
    IO.println s!"new inv={if Checksum.Inv me then 1 else 0}"
    run me (← IO.getStdin)
  | none => IO.println "new MEMORY ERROR"
