import LabelModel

/-! GENERATED by prover/prooc.py. The model of Label, driven by the script on standard input. -/

partial def run (me : Label) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0"] =>
    match Label.number me with
    | some (me, r) =>
      IO.println s!"number {r.toNat} inv={if Label.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "number MEMORY ERROR"
  | ["1", c0] =>
    match Label.new_v (BitVec.ofNat 64 c0.toNat!) with
    | some me =>
      IO.println s!"new inv={if Label.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "new MEMORY ERROR"
  | ["2", c0] =>
    match Label.new_s (Prooc.Bytes.ofHex c0) with
    | some (.gave me) =>
      IO.println s!"new inv={if Label.Inv me then 1 else 0}"
      run me stdin
    | some _ =>
      IO.println "new thrown"
      run me stdin
    | none => IO.println "new MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

