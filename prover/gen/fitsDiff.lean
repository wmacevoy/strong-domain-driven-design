import fitsModel

/-! GENERATED by prover/prooc.py. The model of fits, driven by the script on standard input. -/

partial def run (me : fits) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0", a0, a1] =>
    match fits.call me (BitVec.ofNat 32 a0.toNat!) (BitVec.ofNat 32 a1.toNat!) with
    | some (me, r) =>
      IO.println s!"call {r.toNat} inv={if fits.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "call MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

def main : IO Unit := do
  match fits.new with
  | some me =>
    IO.println s!"new inv={if fits.Inv me then 1 else 0}"
    run me (← IO.getStdin)
  | none => IO.println "new MEMORY ERROR"
