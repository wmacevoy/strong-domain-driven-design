import FuseModel

/-! GENERATED by prover/prooc.py. The model of Fuse, driven by the script on standard input. -/

partial def run (me : Fuse) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0"] =>
    match Fuse.blow me with
    | some (me, r) =>
      if r matches Prooc.Outcome.ended then
        IO.println "blow ended"
        return
      let said : String := match r with | Prooc.Outcome.gave r => toString r.toNat | _ => "thrown"
      IO.println s!"blow {said} inv={if Fuse.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "blow MEMORY ERROR"
  | ["1"] =>
    match Fuse.count me with
    | some (me, r) =>
      IO.println s!"count {r.toNat} inv={if Fuse.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "count MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

def main : IO Unit := do
  match Fuse.new with
  | some me =>
    IO.println s!"new inv={if Fuse.Inv me then 1 else 0}"
    run me (← IO.getStdin)
  | none => IO.println "new MEMORY ERROR"
