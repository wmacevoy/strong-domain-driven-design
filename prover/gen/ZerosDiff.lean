import ZerosModel

/-! GENERATED by prover/prooc.py. The model of Zeros, driven by the script on standard input. -/

partial def run (me : Zeros) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0", a0] =>
    match Zeros.take 4294967296 me (Prooc.Bytes.ofHex a0) with
    | some (me, _) =>
      IO.println s!"take - inv={if Zeros.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "take MEMORY ERROR"
  | ["1"] =>
    match Zeros.getZeros me with
    | some (me, r) =>
      IO.println s!"getZeros {r.toNat} inv={if Zeros.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "getZeros MEMORY ERROR"
  | ["2"] =>
    match Zeros.getSeen me with
    | some (me, r) =>
      IO.println s!"getSeen {r.toNat} inv={if Zeros.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "getSeen MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

def main : IO Unit := do
  match Zeros.new with
  | some me =>
    IO.println s!"new inv={if Zeros.Inv me then 1 else 0}"
    run me (← IO.getStdin)
  | none => IO.println "new MEMORY ERROR"
