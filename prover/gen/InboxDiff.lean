import InboxModel

/-! GENERATED by prover/prooc.py. The model of Inbox, driven by the script on standard input. -/

partial def run (me : Inbox) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0", a0] =>
    match Inbox.keep me (Prooc.Bytes.ofHex a0) with
    | some (me, _) =>
      IO.println s!"keep - inv={if Inbox.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "keep MEMORY ERROR"
  | ["1", a0] =>
    match Inbox.«at» me (BitVec.ofNat 64 a0.toNat!) with
    | some (me, r) =>
      IO.println s!"at {r.toNat} inv={if Inbox.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "at MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

def main : IO Unit := do
  match Inbox.new with
  | some me =>
    IO.println s!"new inv={if Inbox.Inv me then 1 else 0}"
    run me (← IO.getStdin)
  | none => IO.println "new MEMORY ERROR"
