import StationModel

/-! GENERATED by prover/prooc.py. The model of Station, driven by the script on standard input. -/

partial def run (me : Station) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0"] =>
    match Station.pull me with
    | some (me, r) =>
      IO.println s!"pull {r.toNat} inv={if Station.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "pull MEMORY ERROR"
  | ["1"] =>
    match Station.emptyTray me with
    | some (me, _) =>
      IO.println s!"emptyTray - inv={if Station.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "emptyTray MEMORY ERROR"
  | ["2"] =>
    match Station.refill me with
    | some (me, _) =>
      IO.println s!"refill - inv={if Station.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "refill MEMORY ERROR"
  | ["3"] =>
    match Station.pulled me with
    | some (me, r) =>
      IO.println s!"pulled {r.toNat} inv={if Station.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "pulled MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

def main : IO Unit := do
  match Station.new with
  | some me =>
    IO.println s!"new inv={if Station.Inv me then 1 else 0}"
    run me (← IO.getStdin)
  | none => IO.println "new MEMORY ERROR"
