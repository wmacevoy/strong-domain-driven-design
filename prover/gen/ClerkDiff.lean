import ClerkModel

/-! GENERATED by prover/prooc.py. The model of Clerk, driven by the script on standard input. -/

partial def run (me : Clerk) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0"] =>
    match Clerk.note me with
    | some (me, r) =>
      IO.println s!"note {r.toNat} inv={if Clerk.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "note MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

def main : IO Unit := do
  match Clerk.new with
  | some me =>
    IO.println s!"new inv={if Clerk.Inv me then 1 else 0}"
    run me (← IO.getStdin)
  | none => IO.println "new MEMORY ERROR"
