import bounded_checked_ofModel

/-! GENERATED by cpp-proof-gen/prooc.py. The model of bounded_checked_of, at one type, driven by the script. -/

partial def run {T : Type} [LE T] [DecidableLE T] [Inhabited T] (A : T) (B : T) (rd : Nat → T) (wr : T → Nat) (me? : Option (bounded_checked_of T)) (lines : List String) : IO Unit := do
  match lines with
  | [] => return
  | line :: rest =>
  match line.splitOn " ", me? with
  | ["1", c0], _ =>
    match bounded_checked_of.new A B (rd c0.toNat!) with
    | some me =>
      IO.println s!"new inv={if bounded_checked_of.Inv A B me then 1 else 0}"
      run A B rd wr (some me) rest
    | none =>
      IO.println "new pre"
      run A B rd wr me? rest
  | ["0"], some me =>
    match bounded_checked_of.number A B me with
    | some (me, r) =>
      IO.println s!"number {wr r} inv={if bounded_checked_of.Inv A B me then 1 else 0}"
      run A B rd wr (some me) rest
    | none =>
      IO.println "number MEMORY ERROR"
      run A B rd wr (some me) rest
  | _, none =>
    IO.println "no object"
    run A B rd wr none rest
  | _, _ => IO.println "a line the script should not have"

partial def all (stdin : IO.FS.Stream) (sofar : Array String) : IO (List String) := do
  let line ← stdin.getLine
  if line.isEmpty then return sofar.toList
  all stdin (sofar.push (line.splitOn "\n").head!)

def main : IO Unit := do
  let lines ← all (← IO.getStdin) #[]
  IO.println "uint64_t"
  run 5#64 1000#64 (fun w => (BitVec.ofNat 64 w)) (fun (r : BitVec 64) => r.toNat) none lines
  IO.println "int64_t"
  run (-5 : Int64) (1000 : Int64) (fun w => (UInt64.ofNat w).toInt64) (fun (r : Int64) => r.toUInt64.toNat) none lines
  IO.println "double"
  run (-1.5 : Float) (2.5 : Float) (fun w => (Float.ofBits (UInt64.ofNat w))) (fun (r : Float) => r.toBits.toNat) none lines
  IO.println "float"
  run (-1.5 : Float32) (2.5 : Float32) (fun w => (Float32.ofBits (UInt32.ofNat w))) (fun (r : Float32) => r.toBits.toNat) none lines
