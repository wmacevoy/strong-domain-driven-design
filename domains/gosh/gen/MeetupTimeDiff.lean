import MeetupTimeModel

/-! GENERATED by prover/prooc.py. The model of MeetupTime, driven by the script on standard input. -/

partial def run (me : MeetupTime) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0", a0] =>
    match MeetupTime.read_checked me (Prooc.Bytes.ofHex a0) with
    | some (me, r) =>
      IO.println s!"read_checked {r.toNat} inv={if MeetupTime.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "read_checked MEMORY ERROR"
  | ["1"] =>
    match MeetupTime.answering_checked me with
    | some (me, r) =>
      IO.println s!"answering_checked {r.toNat} inv={if MeetupTime.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "answering_checked MEMORY ERROR"
  | ["2"] =>
    match MeetupTime.time_checked me with
    | some (me, r) =>
      IO.println s!"time_checked {r.toNat} inv={if MeetupTime.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "time_checked MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

def main : IO Unit := do
  match MeetupTime.new with
  | some me =>
    IO.println s!"new inv={if MeetupTime.Inv me then 1 else 0}"
    run me (← IO.getStdin)
  | none => IO.println "new MEMORY ERROR"
