import MeetupPassModel

/-! GENERATED by prover/prooc.py. The model of MeetupPass, driven by the script on standard input. -/

partial def run (me : MeetupPass) (stdin : IO.FS.Stream) : IO Unit := do
  let line ← stdin.getLine
  if line.isEmpty then return
  match (line.splitOn "\n").head!.splitOn " " with
  | ["0", a0] =>
    match MeetupPass.read_checked me (Prooc.Bytes.ofHex a0) with
    | some (me, r) =>
      IO.println s!"read_checked {r.toNat} inv={if MeetupPass.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "read_checked MEMORY ERROR"
  | ["1"] =>
    match MeetupPass.length_checked me with
    | some (me, r) =>
      IO.println s!"length_checked {r.toNat} inv={if MeetupPass.Inv me then 1 else 0}"
      run me stdin
    | none => IO.println "length_checked MEMORY ERROR"
  | _ => IO.println "a line the script should not have"

def main : IO Unit := do
  match MeetupPass.new with
  | some me =>
    IO.println s!"new inv={if MeetupPass.Inv me then 1 else 0}"
    run me (← IO.getStdin)
  | none => IO.println "new MEMORY ERROR"
